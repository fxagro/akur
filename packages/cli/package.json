{
  "name": "@akur/cli",
  "version": "0.1.0",
  "description": "Command line interface untuk mengelola modul Akur ERP",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fxagro/akur.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "akur": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@akur/core": "*",
    "@akur/registry": "*"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5"
  }
}
