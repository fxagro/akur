{
  "name": "@akur/registry",
  "version": "0.1.0",
  "description": "Katalog modul dan installer untuk Akur ERP",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fxagro/akur.git",
    "directory": "packages/registry"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@akur/core": "*"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5"
  }
}
