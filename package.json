{
  "name": "akur",
  "version": "0.1.0",
  "description": "Akur ERP - Sistem ERP & Akuntansi Open Source untuk Indonesia (Community & Enterprise)",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/fxagro/akur#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/fxagro/akur.git"
  },
  "bugs": {
    "url": "https://github.com/fxagro/akur/issues"
  },
  "keywords": [
    "erp",
    "akuntansi",
    "indonesia",
    "psak",
    "ppn",
    "double-entry",
    "open-source"
  ],
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "build:packages": "turbo run build --filter=\"./packages/*\"",
    "test:packages": "turbo run test --filter=\"./packages/*\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:tunnel": "powershell -ExecutionPolicy Bypass -File ./scripts/db-tunnel.ps1",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.8",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "turbo": "^2.0.0"
  }
}